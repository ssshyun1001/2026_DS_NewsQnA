# LLM 연결: OPENAI_BASE_URL을 비우면 OpenAI 공식 API
# 학교 팩트챗 Gateway를 쓰면 아래 주소 + 팩트챗에서 발급한 키를 OPENAI_API_KEY에 넣는다
OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
