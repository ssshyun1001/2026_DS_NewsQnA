OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# DB: 로컬 Docker(docker compose up -d)는 POSTGRES_PASSWORD를 정하고 아래 주소에 같은 비밀번호를 넣는다
# 팀 공용 DB(Supabase)를 쓰면 DATABASE_URL을 DB 담당에게 받은 주소로 바꾼다 (POSTGRES_PASSWORD는 필요 없음)
# 팀 공용 DB 구축 완료
#   예: postgresql://postgres.<프로젝트ID>:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://qupict:비밀번호@localhost:5432/qupict

# LLM 연결: OPENAI_BASE_URL을 비우면 OpenAI 공식 API
# 학교 팩트챗 Gateway를 쓰면 아래 주소 + 팩트챗에서 발급한 키를 OPENAI_API_KEY에 넣는다
OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
OPENAI_CHAT_MODEL=claude-haiku-5-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 답변 근거로 쓸 최소 유사도 (기본 0.5 = 엄격). 낮추면 근거를 더 많이 쓰지만 덜 관련된 내용이 섞일 수 있음
# RELEVANCE_SIMILARITY_THRESHOLD=0.5

# 서비스(run.py · web.py)에서 이미지 설명(VLM)을 새로 만들지 (기본 0 = 끔: 준비 시간의 약 2/3를 차지해서)
# DESCRIBE_IMAGES=1
