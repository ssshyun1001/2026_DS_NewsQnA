OPENAI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# DB: Google Cloud Firestore (프로젝트 qupict, (default) DB, 서울 asia-northeast3)
#   로컬 인증은 키 파일 없이 본인 Google 계정으로 (조직 정책상 서비스 계정 키는 만들 수 없음):
#     gcloud auth application-default login
#     gcloud auth application-default set-quota-project qupict
#   Cloud Run은 붙어 있는 서비스 계정으로 인증한다 (Cloud Datastore 사용자 역할 필요). 비우면 DB 없이 메모리 버전으로 돈다
FIRESTORE_PROJECT=qupict
# FIRESTORE_DATABASE=(default)

# LLM 연결: OPENAI_BASE_URL을 비우면 OpenAI 공식 API
# 학교 팩트챗 Gateway를 쓰면 아래 주소 + 팩트챗에서 발급한 키를 OPENAI_API_KEY에 넣는다
OPENAI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
OPENAI_CHAT_MODEL=claude-haiku-5-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 답변 근거로 쓸 최소 유사도 (기본 0.5 = 엄격). 낮추면 근거를 더 많이 쓰지만 덜 관련된 내용이 섞일 수 있음
# RELEVANCE_SIMILARITY_THRESHOLD=0.5

# 서비스(run.py · web.py)에서 기사 이미지를 글로 바꾸는 방법 (기본 ocr). "준비 완료" 뒤 백그라운드에서 한다
#   ocr = 이미지 속 글자 읽기 (EasyOCR, LLM 비용 0)   vlm = LLM이 이미지 설명 (느리고 비용 있음)   off = 안 함
# IMAGE_TEXT=ocr
